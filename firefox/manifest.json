{
  "manifest_version": 3,
  "name": "Klaudíčko",
  "version": "1.0.2",
  "description": "Počeští názvy AI asistentů",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://gemini.google.com/*", "https://chatgpt.com/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "klaudicko-rozsireni-2026@addon",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
