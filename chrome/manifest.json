{
  "manifest_version": 3,
  "name": "Klaudíčko",
  "version": "1.0.2",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "description": "Počeští názvy AI asistentů",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://gemini.google.com/*", "https://chatgpt.com/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage"
  ]
}
